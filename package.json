{
  "name": "nexa-ui",
  "version": "0.1.0",
  "description": "Modern Vue 3 component library with atomic design principles",
  "type": "module",
  "keywords": [
    "vue",
    "vue3",
    "component-library",
    "ui",
    "typescript",
    "unocss"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/nexa-ui.umd.cjs",
  "module": "./dist/nexa-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nexa-ui.js",
      "require": "./dist/nexa-ui.umd.cjs"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "@vueuse/motion": "^2.0.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.23",
    "@iconify-json/mdi": "^1.2.3",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^22.10.2",
    "@unocss/preset-icons": "^0.65.4",
    "@unocss/preset-uno": "^0.65.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vueuse/motion": "^2.2.6",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.3",
    "unocss": "^0.65.4",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
