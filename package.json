{
  "name": "nexa-ui",
  "version": "0.1.0",
  "description": "Modern Vue 3 component library with atomic design principles",
  "type": "module",
  "keywords": [
    "vue",
    "vue3",
    "component-library",
    "ui",
    "typescript",
    "unocss"
  ],
  "license": "MIT",
  "main": "./dist/nexa-ui.umd.cjs",
  "module": "./dist/nexa-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/nexa-ui.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/nexa-ui.umd.cjs"
      }
    },
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^25.9.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vueuse/motion": "^2.2.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "unocss": "^0.64.1",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  }
}
