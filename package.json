{
  "name": "nexa-ui",
  "version": "0.1.0",
  "description": "Modern Vue 3 component library with atomic design principles",
  "type": "module",
  "keywords": [
    "vue",
    "vue3",
    "component-library",
    "ui",
    "typescript",
    "unocss"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/nexa-ui.umd.cjs",
  "module": "./dist/nexa-ui.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nexa-ui.js",
      "require": "./dist/nexa-ui.umd.cjs"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "npm run typecheck && vite build --mode lib",
    "build:lib": "vite build --mode lib",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "peerDependencies": {
    "vue": "~3.4.0"
  },
  "overrides": {
    "@vue/test-utils": "2.4.6"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.1.64",
    "@testing-library/vue": "^7.0.0",
    "@types/node": "^20.11.0",
    "@unocss/preset-icons": "^0.58.5",
    "@unocss/reset": "^0.58.5",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "2.4.6",
    "@vueuse/motion": "^2.1.2",
    "happy-dom": "^13.6.2",
    "typescript": "^5.3.3",
    "unocss": "^0.58.5",
    "vite": "^5.1.4",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^1.3.1",
    "vue": "~3.4.0",
    "vue-tsc": "^2.0.29"
  }
}
