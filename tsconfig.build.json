{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/index.ts",
    "src/shims-vue.d.ts",
    "src/types/**/*.ts",
    "src/utils/**/*.ts",
    "src/composables/**/*.ts",
    "src/components/**/*.ts",
    "src/components/**/*.vue"
  ],
  "exclude": [
    "src/main.ts",
    "src/App.vue",
    "src/counter.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}
